// Schéma de base de données pour système de gestion d'auto-école

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// UTILISATEURS ET AUTHENTIFICATION
// ============================================

enum Role {
  ADMIN           // Direction / Administrateur
  SECRETARY       // Secrétariat
  INSTRUCTOR      // Moniteur
  STUDENT         // Élève
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  role          Role
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  student       Student?
  instructor    Instructor?

  @@map("users")
}

// ============================================
// ÉLÈVES
// ============================================

enum StudentStatus {
  ACTIVE          // En formation
  COMPLETED       // Formation terminée
  SUSPENDED       // Suspendu
  CANCELLED       // Annulé
}

enum FormationType {
  TRADITIONAL     // Formation traditionnelle (B)
  AAC             // Conduite accompagnée (AAC)
  SUPERVISED      // Conduite supervisée
  ACCELERATED     // Stage accéléré
}

model Student {
  id                String         @id @default(cuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Informations personnelles
  dateOfBirth       DateTime
  placeOfBirth      String
  address           String
  city              String
  postalCode        String

  // Documents administratifs
  neph              String?        @unique // Numéro d'enregistrement préfectoral harmonisé
  idCardNumber      String?
  idCardExpiry      DateTime?

  // Formation
  formationType     FormationType  @default(TRADITIONAL)
  status            StudentStatus  @default(ACTIVE)
  registrationDate  DateTime       @default(now())

  // Heures de formation
  codeHoursPaid     Int            @default(0)
  codeHoursUsed     Int            @default(0)
  driveHoursPaid    Float          @default(0)
  driveHoursUsed    Float          @default(0)

  // Examens
  codeExamDate      DateTime?
  codeExamPassed    Boolean?
  codeExamResult    DateTime?
  driveExamDate     DateTime?
  driveExamPassed   Boolean?
  driveExamAttempts Int            @default(0)

  // Évaluation initiale
  initialEvaluation Float?         // Nombre d'heures estimées
  evaluationDate    DateTime?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relations
  lessonEnrollments LessonStudent[]
  payments          Payment[]
  documents         Document[]
  evaluations       Evaluation[]
  invoices          Invoice[]
  packagePurchases  PackagePurchase[]
  bookings          Booking[]
  learningLogbook   LearningLogbook?
  exams             Exam[]

  @@map("students")
}

// ============================================
// MONITEURS
// ============================================

enum InstructorStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

model Instructor {
  id                String            @id @default(cuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Qualifications
  diploma           String            // BEPECASER ou Titre Pro
  diplomaNumber     String
  diplomaExpiry     DateTime?

  // Disponibilités
  status            InstructorStatus  @default(ACTIVE)
  weeklyHours       Int               @default(35)

  // Statistiques
  totalHoursTaught  Float             @default(0)
  successRate       Float?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  lessons           Lesson[]
  availabilities    Availability[]
  vehicles          Vehicle[]         // Véhicules assignés
  bookings          Booking[]

  @@map("instructors")
}

// ============================================
// VÉHICULES
// ============================================

enum VehicleType {
  CAR_MANUAL        // Voiture manuelle
  CAR_AUTOMATIC     // Voiture automatique
  MOTORCYCLE        // Moto
  TRUCK             // Poids lourd
}

enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE
}

model Vehicle {
  id                String         @id @default(cuid())

  // Informations véhicule
  brand             String         // Renault, Peugeot, etc.
  model             String
  plateNumber       String         @unique
  type              VehicleType
  year              Int

  // État
  status            VehicleStatus  @default(AVAILABLE)
  mileage           Int            @default(0)

  // Entretien
  lastMaintenance   DateTime?
  nextMaintenance   DateTime?
  technicalControl  DateTime?      // Contrôle technique
  insuranceExpiry   DateTime

  // Assignation
  instructorId      String?
  instructor        Instructor?    @relation(fields: [instructorId], references: [id])

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relations
  lessons           Lesson[]
  maintenances      Maintenance[]
  bookings          Booking[]

  @@map("vehicles")
}

// ============================================
// PLANNING ET LEÇONS
// ============================================

enum LessonType {
  CODE              // Séance de code
  DRIVE             // Leçon de conduite
  EXAM_PREPARATION  // Préparation examen
  EVALUATION        // Évaluation
}

enum LessonStatus {
  SCHEDULED         // Planifiée
  CONFIRMED         // Confirmée
  COMPLETED         // Terminée
  CANCELLED         // Annulée
  NO_SHOW           // Élève absent
}

model Lesson {
  id              String        @id @default(cuid())

  // Participants - Support multi-élèves
  students        LessonStudent[]
  instructorId    String?
  instructor      Instructor?   @relation(fields: [instructorId], references: [id])
  vehicleId       String?
  vehicle         Vehicle?      @relation(fields: [vehicleId], references: [id])

  // Détails
  type            LessonType
  status          LessonStatus  @default(SCHEDULED)
  startTime       DateTime
  endTime         DateTime
  duration        Float         // En heures (1.0, 1.5, 2.0, etc.)

  // Cours collectif
  isGroupLesson   Boolean       @default(false) // true si 2+ élèves

  // Contenu
  topic           String?       // Sujet de la leçon
  notes           String?       // Notes du moniteur
  location        String?       // Lieu de RDV

  // Annulation
  cancelledAt     DateTime?
  cancelReason    String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relation avec réservation
  bookingId       String?       @unique
  booking         Booking?      @relation(fields: [bookingId], references: [id])

  @@map("lessons")
}

// ============================================
// TABLE DE LIAISON LESSON-STUDENT
// ============================================

model LessonStudent {
  id              String    @id @default(cuid())

  // Relations
  lessonId        String
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Gestion des présences
  attended        Boolean   @default(true)    // Présent ou absent

  // Tracking des heures déduites
  hoursDeducted   Float?                      // Heures réellement déduites

  // Notes spécifiques à l'élève pour cette leçon
  studentNotes    String?

  createdAt       DateTime  @default(now())

  // Empêcher qu'un élève soit inscrit 2 fois à la même leçon
  @@unique([lessonId, studentId])
  @@map("lesson_students")
}

// ============================================
// DISPONIBILITÉS MONITEURS
// ============================================

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Availability {
  id            String      @id @default(cuid())
  instructorId  String
  instructor    Instructor  @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  dayOfWeek     DayOfWeek
  startTime     String      // Format: "09:00"
  endTime       String      // Format: "18:00"
  isRecurring   Boolean     @default(true)

  // Pour les indisponibilités ponctuelles
  specificDate  DateTime?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("availabilities")
}

// ============================================
// ÉVALUATIONS
// ============================================

model Evaluation {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Compétences (Grille GDE française)
  // Compétence 1 : Maîtriser le maniement du véhicule
  competence1 Int      @default(0) // Score sur 5

  // Compétence 2 : Appréhender la route et circuler
  competence2 Int      @default(0)

  // Compétence 3 : Circuler dans des conditions difficiles
  competence3 Int      @default(0)

  // Compétence 4 : Pratiquer une conduite autonome et sûre
  competence4 Int      @default(0)

  // Général
  globalScore Float?
  comments    String?
  evaluator   String   // Nom du moniteur

  createdAt   DateTime @default(now())

  @@map("evaluations")
}

// ============================================
// PAIEMENTS ET FACTURATION
// ============================================

enum PaymentMethod {
  CASH              // Espèces
  CARD              // Carte bancaire
  TRANSFER          // Virement
  CHECK             // Chèque
  CPF               // Compte Personnel de Formation
  INSTALLMENT       // Échelonnement
}

enum PaymentStatus {
  PENDING           // En attente
  COMPLETED         // Payé
  FAILED            // Échoué
  REFUNDED          // Remboursé
}

model Payment {
  id              String        @id @default(cuid())
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  amount          Float
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)

  description     String?       // Description du paiement
  transactionId   String?       // ID de transaction (Stripe, etc.)

  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  invoiceId       String?
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

// ============================================
// FACTURES
// ============================================

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Détails
  status          InvoiceStatus @default(DRAFT)
  totalAmount     Float
  paidAmount      Float         @default(0)
  dueDate         DateTime?

  // Contenu
  items           InvoiceItem[]

  // Dates
  issuedAt        DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  payments        Payment[]

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Float
  unitPrice   Float
  totalPrice  Float

  @@map("invoice_items")
}

// ============================================
// DOCUMENTS
// ============================================

enum DocumentType {
  ID_CARD           // Pièce d'identité
  PROOF_ADDRESS     // Justificatif de domicile
  MEDICAL_CERT      // Certificat médical
  PHOTO             // Photo d'identité
  CONTRACT          // Contrat de formation
  TRAINING_BOOK     // Livret d'apprentissage
  CERTIFICATE       // Attestation
  OTHER             // Autre
}

model Document {
  id          String        @id @default(cuid())
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  type        DocumentType
  name        String
  filePath    String
  fileSize    Int?
  mimeType    String?

  expiryDate  DateTime?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("documents")
}

// ============================================
// ENTRETIEN VÉHICULES
// ============================================

enum MaintenanceType {
  OIL_CHANGE        // Vidange
  TIRE_CHANGE       // Changement pneus
  BRAKE_CHECK       // Contrôle freins
  TECHNICAL_CONTROL // Contrôle technique
  REPAIR            // Réparation
  OTHER             // Autre
}

model Maintenance {
  id          String          @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  type        MaintenanceType
  description String
  cost        Float?
  mileage     Int?

  performedAt DateTime
  nextDue     DateTime?

  createdAt   DateTime        @default(now())

  @@map("maintenances")
}

// ============================================
// FORFAITS ET PACKAGES
// ============================================

enum PackageType {
  CODE_ONLY         // Code seul
  DRIVE_ONLY        // Conduite seule
  COMPLETE          // Code + Conduite
  HOURS_PACK        // Pack d'heures supplémentaires
}

model Package {
  id              String        @id @default(cuid())

  name            String        // Ex: "Forfait Code", "20h conduite", "Forfait complet"
  description     String?
  type            PackageType

  // Contenu du forfait
  codeHours       Int           @default(0)  // Heures de code incluses
  driveHours      Float         @default(0)  // Heures de conduite incluses

  // Prix
  price           Float

  // Validité
  validityMonths  Int?          // Durée de validité en mois (null = illimité)

  // Disponibilité
  isActive        Boolean       @default(true)
  isPopular       Boolean       @default(false) // Mis en avant

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  purchases       PackagePurchase[]

  @@map("packages")
}

model PackagePurchase {
  id              String        @id @default(cuid())

  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  packageId       String
  package         Package       @relation(fields: [packageId], references: [id])

  // Heures achetées
  codeHoursBought     Int       @default(0)
  driveHoursBought    Float     @default(0)

  // Heures consommées
  codeHoursUsed       Int       @default(0)
  driveHoursUsed      Float     @default(0)

  // Prix payé (peut différer du prix du package si promo)
  pricePaid       Float

  // Validité
  purchaseDate    DateTime      @default(now())
  expiryDate      DateTime?     // Date d'expiration du forfait

  // Statut
  isActive        Boolean       @default(true)
  isExpired       Boolean       @default(false)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("package_purchases")
}

// ============================================
// RÉSERVATIONS
// ============================================

enum BookingStatus {
  PENDING         // En attente de confirmation
  CONFIRMED       // Confirmée
  COMPLETED       // Effectuée
  CANCELLED       // Annulée
  NO_SHOW         // Absence élève
}

model Booking {
  id              String        @id @default(cuid())

  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  instructorId    String?
  instructor      Instructor?   @relation(fields: [instructorId], references: [id])

  vehicleId       String?
  vehicle         Vehicle?      @relation(fields: [vehicleId], references: [id])

  // Détails de la réservation
  type            LessonType
  startTime       DateTime
  endTime         DateTime
  duration        Float         // En heures

  status          BookingStatus @default(PENDING)

  // Notes
  studentNotes    String?       // Notes de l'élève lors de la réservation
  adminNotes      String?       // Notes internes

  // Annulation
  cancelledAt     DateTime?
  cancelledBy     String?       // ID de l'utilisateur qui a annulé
  cancelReason    String?

  // Règles d'annulation
  canCancel       Boolean       @default(true)
  cancellationDeadline DateTime? // Date limite d'annulation gratuite

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  lesson          Lesson?       // Convertie en leçon une fois confirmée

  @@map("bookings")
}

// ============================================
// LIVRET D'APPRENTISSAGE (Grille GDE)
// ============================================

model LearningLogbook {
  id              String        @id @default(cuid())

  studentId       String        @unique
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Compétence 1 : Maîtriser le maniement du véhicule dans un trafic faible ou nul
  // 7 sous-compétences notées sur 5
  comp1_skill1    Int           @default(0) // Connaître les principaux organes
  comp1_skill2    Int           @default(0) // Effectuer des vérifications
  comp1_skill3    Int           @default(0) // Entrer, s'installer, sortir
  comp1_skill4    Int           @default(0) // Tenir, tourner le volant
  comp1_skill5    Int           @default(0) // Démarrer et s'arrêter
  comp1_skill6    Int           @default(0) // Doser l'accélération et le freinage
  comp1_skill7    Int           @default(0) // Utiliser la boîte de vitesses
  comp1_validated Boolean       @default(false)

  // Compétence 2 : Appréhender la route et circuler dans des conditions normales
  comp2_skill1    Int           @default(0) // Connaître et respecter les règles
  comp2_skill2    Int           @default(0) // Rechercher la signalisation
  comp2_skill3    Int           @default(0) // Positionner le véhicule sur la chaussée
  comp2_skill4    Int           @default(0) // Adapter l'allure aux situations
  comp2_skill5    Int           @default(0) // Détecter et identifier les indices
  comp2_skill6    Int           @default(0) // Tourner à droite et à gauche
  comp2_skill7    Int           @default(0) // Franchir les intersections
  comp2_validated Boolean       @default(false)

  // Compétence 3 : Circuler dans des conditions difficiles et partager la route
  comp3_skill1    Int           @default(0) // Évaluer et maintenir les distances
  comp3_skill2    Int           @default(0) // Croiser, dépasser, être dépassé
  comp3_skill3    Int           @default(0) // Passer des virages et conduire en déclivité
  comp3_skill4    Int           @default(0) // Connaître les caractéristiques des autres usagers
  comp3_skill5    Int           @default(0) // S'insérer, circuler, sortir d'une voie rapide
  comp3_skill6    Int           @default(0) // Conduire dans une file de véhicules
  comp3_skill7    Int           @default(0) // Conduire en situation de visibilité réduite
  comp3_validated Boolean       @default(false)

  // Compétence 4 : Pratiquer une conduite autonome, sûre et économique
  comp4_skill1    Int           @default(0) // Suivre un itinéraire de manière autonome
  comp4_skill2    Int           @default(0) // Préparer et effectuer un voyage longue distance
  comp4_skill3    Int           @default(0) // Connaître les comportements à risque
  comp4_skill4    Int           @default(0) // Connaître les facteurs de vigilance
  comp4_skill5    Int           @default(0) // Prendre conscience des responsabilités
  comp4_skill6    Int           @default(0) // Connaître les comportements économiques
  comp4_skill7    Int           @default(0) // Connaître les aides à la conduite
  comp4_validated Boolean       @default(false)

  // Progression globale
  overallProgress Float         @default(0) // Pourcentage de 0 à 100
  isComplete      Boolean       @default(false)
  completedAt     DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("learning_logbooks")
}

// ============================================
// EXAMENS
// ============================================

enum ExamType {
  CODE          // Examen du code
  DRIVE         // Examen de conduite
}

enum ExamStatus {
  SCHEDULED     // Programmé
  PASSED        // Réussi
  FAILED        // Échoué
  CANCELLED     // Annulé
  NO_SHOW       // Absence
}

model Exam {
  id              String        @id @default(cuid())

  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  type            ExamType
  status          ExamStatus    @default(SCHEDULED)

  // Détails examen
  examDate        DateTime
  examCenter      String?       // Centre d'examen
  examAddress     String?

  // Résultat
  result          Boolean?      // true = réussi, false = échoué
  score           Int?          // Score obtenu (pour code)
  maxScore        Int?          // Score maximum (40 pour code)

  // Notes
  notes           String?       // Commentaires de l'examinateur
  faults          String?       // Fautes commises (pour conduite)

  // Accompagnateur (pour conduite)
  accompaniedBy   String?       // Nom du moniteur accompagnateur

  // Documents
  convocationSent Boolean       @default(false)
  convocationDate DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("exams")
}
